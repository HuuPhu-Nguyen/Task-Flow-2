<configuration>
    <property name="TASKFLOW_LOG_LEVEL" value="${TASKFLOW_LOG_LEVEL:-INFO}" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level thread=%thread logger=%logger{36} %msg%n%ex{full}</pattern>
        </encoder>
    </appender>

    <logger name="com.rabbitmq.client" level="WARN" />
    <logger name="org.apache.pdfbox" level="WARN" />
    <logger name="org.bytedeco" level="WARN" />

    <root level="${TASKFLOW_LOG_LEVEL}">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
